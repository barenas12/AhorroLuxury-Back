PORT=3000
NODE_ENV=development

# Autenticación JWT (obligatorio: mínimo 32 caracteres aleatorios en producción)
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars_long
JWT_EXPIRES_IN=8h

# Base de Datos MySQL / TiDB Cloud
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=luxury
# Opcional: ruta al certificado CA si tu entorno no incluye ISRG Root X1
# DB_CA_PATH=
# Opcional: orígenes extra permitidos por CORS separados por coma
# CORS_ORIGINS=https://ahorro-luxury-web-one.vercel.app
